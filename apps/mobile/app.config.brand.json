{
  "expo": {
    "name": "Lumen",
    "scheme": "lumen",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/icon-ios-1024.png",
    "ios": {
      "icon": {
        "light": "./assets/brand/icon-ios-1024.png",
        "dark": "./assets/brand/icon-ios-dark-1024.png",
        "tinted": "./assets/brand/icon-ios-tinted-1024.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-foreground-432.png",
        "monochromeImage": "./assets/brand/android-monochrome-432.png",
        "backgroundColor": "#0B0E14"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-icon-512.png",
          "imageWidth": 160,
          "backgroundColor": "#F3F5F9",
          "dark": { "image": "./assets/brand/splash-icon-512.png", "backgroundColor": "#0B0E14" }
        }
      ],
      ["expo-notifications", { "icon": "./assets/brand/notification-icon-96.png", "color": "#2EC4B6" }]
    ]
  }
}
