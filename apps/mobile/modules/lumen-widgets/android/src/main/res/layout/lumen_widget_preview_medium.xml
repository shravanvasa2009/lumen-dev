<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's preview of the medium widget: the same sample reading as the in-app gallery and the Widgets mockup
     (64 bpm, "Up to date", "Last check 2 h ago", Check now over Full Scan; LumenWidgets.kt MediumBody). The app's
     name comes from lumen_widget_preview_name, which the config plugin sets to the app's name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lumen_widget_preview_card"
    android:orientation="horizontal"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <include
                layout="@layout/lumen_widget_preview_mark"
                android:layout_width="8dp"
                android:layout_height="16dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:text="@string/lumen_widget_preview_name"
                android:textColor="@color/lumen_widget_preview_text_dim"
                android:textSize="13sp" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/lumen_widget_sample_bpm"
                android:textColor="@color/lumen_widget_preview_text"
                android:textSize="40sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="7dp"
                android:maxLines="1"
                android:text="@string/lumen_widget_sample_bpm_unit"
                android:textColor="@color/lumen_widget_preview_text_dim"
                android:textSize="16sp" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/lumen_widget_sample_status"
            android:textColor="@color/lumen_widget_preview_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/lumen_widget_sample_last_check"
            android:textColor="@color/lumen_widget_preview_text_dim"
            android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="148dp"
        android:layout_height="match_parent"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/lumen_widget_preview_pill_filled"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/lumen_widget_check_now"
            android:textColor="@color/lumen_widget_preview_on_button_fill"
            android:textSize="15sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/lumen_widget_preview_pill_tonal"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/lumen_widget_full_scan"
            android:textColor="@color/lumen_widget_preview_on_tonal_fill"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
