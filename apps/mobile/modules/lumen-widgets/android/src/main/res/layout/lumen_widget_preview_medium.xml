<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's preview of the medium widget: its empty state (mockup 32, LumenWidgets.kt MediumBody). The app's
     name is left out because a library resource can't name the app's label; the mark identifies it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lumen_widget_preview_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">
        <include layout="@layout/lumen_widget_preview_mark" />
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:text="@string/lumen_widget_empty_title"
            android:textColor="@color/lumen_widget_preview_text"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/lumen_widget_empty_body"
            android:textColor="@color/lumen_widget_preview_text_dim"
            android:textSize="14sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/lumen_widget_preview_pill_filled"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/lumen_widget_check_now"
            android:textColor="@color/lumen_widget_preview_on_accent_fill"
            android:textSize="15sp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/lumen_widget_preview_pill_outline"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/lumen_widget_full_scan"
            android:textColor="@color/lumen_widget_preview_text"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
