<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's preview of the small widget: its empty state, the first thing a new widget shows (mockup 32,
     LumenWidgets.kt SmallBody). Static views only, as the picker requires. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lumen_widget_preview_card"
    android:orientation="vertical"
    android:padding="14dp">
    <include layout="@layout/lumen_widget_preview_mark" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:text="@string/lumen_widget_empty_title"
        android:textColor="@color/lumen_widget_preview_text"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/lumen_widget_empty_body"
        android:textColor="@color/lumen_widget_preview_text_dim"
        android:textSize="13sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/lumen_widget_preview_pill_filled"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/lumen_widget_check_now"
        android:textColor="@color/lumen_widget_preview_on_accent_fill"
        android:textSize="15sp" />
</LinearLayout>
