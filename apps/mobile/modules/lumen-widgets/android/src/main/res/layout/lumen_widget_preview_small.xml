<?xml version="1.0" encoding="utf-8"?>
<!-- The picker's preview of the small widget: the same sample reading as the in-app gallery and the Widgets mockup
     (the full up-to-date ring and the mark, "Up to date", "Last check 2 h ago", Check now; LumenWidgets.kt SmallBody).
     Static views only, as the picker requires. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lumen_widget_preview_card"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/lumen_widget_ring"
            android:tint="@color/lumen_widget_preview_ring_track" />
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/lumen_widget_ring"
            android:tint="@color/lumen_widget_preview_accent" />
        </FrameLayout>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <include
            layout="@layout/lumen_widget_preview_mark"
            android:layout_width="10dp"
            android:layout_height="20dp" />
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:text="@string/lumen_widget_sample_status"
        android:textColor="@color/lumen_widget_preview_text"
        android:textSize="17sp"
        android:textStyle="bold" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/lumen_widget_sample_last_check"
        android:textColor="@color/lumen_widget_preview_text_dim"
        android:textSize="12sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/lumen_widget_preview_pill_filled"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/lumen_widget_check_now"
        android:textColor="@color/lumen_widget_preview_on_button_fill"
        android:textSize="15sp" />
</LinearLayout>
