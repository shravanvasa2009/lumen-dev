{
  "name": "@lumen/core",
  "private": true,
  "version": "0.1.0",
  "description": "Pure TypeScript signal processing for Lumen (spec section 10)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "tsc --noEmit -p . && tsc --noEmit -p test && jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "synthetic-suite"
    ],
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/test/tsconfig.json"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "jest": "29.7.0",
    "ts-jest": "29.4.14"
  }
}
